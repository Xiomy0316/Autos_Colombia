# Plantilla de nginx. En el arranque del contenedor, el script oficial de
# envsubst sustituye PORT y API_URL (definidas en el entorno); el resto de
# variables ($host, etc.) se dejan intactas.
server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;
    gzip_proxied any;

    # La interfaz llama a /api (environment.prod.ts) y nginx la reenvía al
    # servicio del backend. API_URL debe ser SOLO el origen, sin barra final:
    #   Render      -> https://autos-colombia-api.onrender.com
    #   docker-comp -> http://backend:8000
    location /api/ {
        proxy_pass ${API_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_ssl_server_name on;

        # Render puede tardar en despertar el servicio en frío.
        proxy_connect_timeout 60s;
        proxy_send_timeout 120s;
        proxy_read_timeout 120s;
    }

    # Los bundles llevan hash en el nombre (outputHashing: all): cache largo.
    location ~* \.(?:js|css)$ {
        add_header Cache-Control "public, max-age=2592000, immutable";
        try_files $uri =404;
    }

    location ~* \.(?:woff2?|png|jpg|jpeg|gif|svg|ico)$ {
        add_header Cache-Control "public, max-age=86400";
        try_files $uri =404;
    }

    # SPA: cualquier ruta desconocida devuelve index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
